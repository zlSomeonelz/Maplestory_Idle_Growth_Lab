{
  "schemaVersion": "0.1",
  "source": {
    "name": "메이플 키우기 공식 능력치 사전",
    "url": "https://maplestoryidle.nexon.com/ko/guide#gnbAllLayer",
    "updatedAt": "2026-09-22"
  },
  "scale": {
    "displayPercentToValue": "percent * 10",
    "multiplier": "(1000 + value) / 1000"
  },
  "stats": {
    "attackPower": {
      "fixedAndPercent": true,
      "rule": "고정 공격력을 먼저 합산한 뒤 공격력% 배율을 적용한다. 전투 중 스킬·유물·동료 등으로 얻는 공격력%는 보유 공격력에 별도 곱연산한다."
    },
    "damage": {
      "combine": "additive",
      "special": "육각 수정 목걸이 특수 효과는 기본 데미지에 별도 곱연산, 최대 3중첩. 전투 중 스킬로 더해진 데미지에는 적용하지 않는다."
    },
    "damageAmplification": {"combine": "additive"},
    "finalDamage": {"combine": "multiplicative", "example": "20%와 30% -> 1.2 * 1.3 = 1.56"},
    "basicAttackDamage": {"combine": "additive", "scope": "basicAttackOnly"},
    "skillDamage": {"combine": "additive", "scope": "skillAttackOnly"},
    "statBasedDamage": {
      "derived": true,
      "formula": "mainStat * 1% + subStat * 0.25%",
      "equivalent": "주 스탯 100당 1%, 부 스탯 400당 1%",
      "combine": "주·부 스탯 합산 후 하나의 값으로 계산"
    },
    "bossMonsterDamage": {"combine": "additive", "scope": "bossOnly", "excludedInPvp": true},
    "normalMonsterDamage": {"combine": "additive", "scope": "normalMonsterOnly", "excludedInPvp": true},
    "statusDamage": {"combine": "additive", "scope": "targetHasStatusOnly"},
    "defense": {
      "fixedAndPercent": true,
      "afterPenetrationFormula": "damageAfterDefense = damageBeforeDefense * 5000 / (defenseAfterPenetration + 6000)",
      "zeroRule": "대상 방어력이 0이면 방어력 공식을 건너뛴다",
      "note": "방어력만으로 받는 피해를 0으로 만들 수 없다"
    },
    "receivedDamageReduction": {
      "cap": 950,
      "combine": "remainingGapMultiplicative",
      "formula": "effective = 1000 - (1000 - current) * product(1 - additional/1000)",
      "damageMultiplier": "(1000 - effective) / 1000",
      "example": "30% + 40% + 50% -> 약 79%"
    },
    "defensePenetration": {
      "cap": 1000,
      "combine": "remainingGapMultiplicative",
      "formula": "defenseAfterPenetration = targetDefense * (1000 - effectivePenetration) / 1000"
    },
    "maxHp": {
      "fixedAndPercent": true,
      "rule": "고정 최대 HP를 합산한 뒤 최대 HP%를 적용한다. 전투 중 최대 HP%는 보유 최대 HP에 별도 곱연산한다.",
      "specialDamageNote": "최대 HP 비례 피해는 HP가 높을수록 커지지만 HP 조정·즉사·일부 특수 피해에는 적용되지 않는다"
    },
    "receivedDamageIncrease": {"combine": "additive", "scope": "targetTakenDamage"},
    "criticalRate": {
      "combine": "additive",
      "actualChance": "attackerCriticalRate - targetCriticalResistance",
      "specialCases": ["강제 크리티컬", "크리티컬 방지 공격"]
    },
    "criticalDamage": {"combine": "additive", "scope": "criticalHitsOnly"},
    "criticalResistance": {"combine": "additive", "scope": "reducesAttackerCriticalRate"},
    "accuracyAndEvasion": {
      "evasionDifference": "targetEvasion - attackerAccuracy",
      "maxEvasionChance": 700,
      "maxRule": "회피가 명중보다 100 높으면 회피 70%, 추가 차이로 70% 초과 불가",
      "missResult": "해당 공격 피해 0",
      "exceptions": ["명중·회피 생략 공격", "일부 PvE의 매우 높은 적 명중"]
    },
    "minDamageMultiplier": {"combine": "additive", "lowerBoundRule": "min cannot exceed max"},
    "maxDamageMultiplier": {"combine": "additive"},
    "mainAndSubStats": {
      "jobDependent": true,
      "attackContribution": {"main": 1.0, "sub": 0.25},
      "statBasedDamageContribution": {"mainPer100": 0.01, "subPer400": 0.01},
      "fixedAndPercent": true,
      "rule": "직업의 주·부 스탯에 해당하는 STR/DEX/INT/LUK을 합산한다. 고정값 합산 후 %를 적용하며 전투 중 %는 보유 스탯에 별도 곱연산한다."
    },
    "attackSpeed": {
      "cap": 1500,
      "combine": "remainingGapMultiplicative",
      "rule": "액션 진행 속도와 일부 연계 지연을 줄여 시간당 공격 횟수에 영향을 준다"
    },
    "skillCooldownReduction": {
      "percentFirst": true,
      "fixedAfterPercent": true,
      "percentCap": 1000,
      "rule": "% 감소 후 고정 초 감소를 적용한다. % 감소 단계 자체에는 4초 하한이 없으며, % 적용 후 4초 이하이면 고정 감소를 적용하지 않는다.",
      "fixedBelowSeven": "7초 미만 구간에서는 1초 감소당 실제 0.5초 감소",
      "minimumSeconds": 4
    },
    "debuffResistance": {
      "scope": "durationOnly",
      "difference": "targetResistance - attackerIgnore",
      "maxDurationReduction": 850,
      "rule": "디버프에 걸릴 확률을 줄이지 않는다. 일부 PvE에서는 적의 디버프 내성 무시로 수치가 감소할 수 있다."
    },
    "companionSummonDuration": {"combine": "additive", "rule": "기본 소환 지속시간에 대한 배율로 적용"},
    "buffDuration": {
      "combine": "additive",
      "rule": "버프를 건 쪽이 아니라 버프를 받은 대상의 버프 지속시간을 사용한다",
      "exceptions": ["버프로 분류되지 않는 상태", "고정 지속시간 효과"]
    },
    "basicAttackTargetCount": {"combine": "additive", "scope": "basicAttackOnly"},
    "jobSkillLevels": {"combine": "additive", "scope": "matchingAdvancementOnly", "display": "base + bonus"},
    "allSkillLevels": {"combine": "additive", "display": "base + bonus"},
    "mainStatPerLevel": {"combine": "additive", "formula": "characterLevel * optionValue"}
  },
  "implementationNotes": [
    "같은 종류의 일반 옵션은 합산하고, 최종 데미지·체감 누적·전투 중 별도 효과는 각각의 규칙으로 처리한다.",
    "보스/일반 몬스터 데미지는 대상 유형에 따라 하나만 선택한다.",
    "큐브 비교에서는 옵션을 단순 전투력으로 환산하지 말고 목표 콘텐츠·현재 수치·적용 범위를 함께 계산한다.",
    "주요 획득처는 옵션 분류 참고용이며 업데이트에 따라 변동될 수 있다."
  ]
}
